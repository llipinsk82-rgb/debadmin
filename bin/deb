#!/usr/bin/env bash
set -euo pipefail

DAT_CONFIG="${DAT_CONFIG:-/etc/debian-admin-toolkit/config}"

if [[ -f "$DAT_CONFIG" ]]; then
    source "$DAT_CONFIG"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"
DAT_HOME="${DAT_HOME:-$DEFAULT_HOME}"
LIB_DIR="$DAT_HOME/lib"
MODULE_DIR="$DAT_HOME/modules"

if [[ ! -d "$LIB_DIR" || ! -d "$MODULE_DIR" ]]; then
    echo "Debian Admin Toolkit is not installed correctly." >&2
    echo "DAT_HOME: $DAT_HOME" >&2
    exit 1
fi

source "$LIB_DIR/core.sh"

COMMAND="${1:-menu}"
shift || true

case "$COMMAND" in
    -h|--help|help)
        dat_help
        exit 0
        ;;
    -v|--version|version)
        dat_version
        exit 0
        ;;
esac

run_module "$COMMAND" "$@"
