#!/usr/bin/env bash
set -euo pipefail

DAT_CONFIG="${DAT_CONFIG:-/etc/debian-admin-toolkit/config}"
[[ -f "$DAT_CONFIG" ]] && source "$DAT_CONFIG"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAT_HOME="${DAT_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}"
LIB_DIR="$DAT_HOME/lib"

source "$LIB_DIR/core.sh"
load_library colors
load_library output
load_library services

services_help() {
    cat <<EOF
DebAdmin Services $DAT_VERSION

Usage:
  deb services                 Show installed/configured service overview
  deb services list            Show installed/configured service overview
  deb services all             Show configured services including missing ones
  deb services status NAME     Show service details
  deb services detail NAME     Show service details
  deb services logs NAME [N]   Show last N journal lines for service
  deb services start NAME      Start service as root
  deb services stop NAME       Stop service as root
  deb services restart NAME    Restart service as root
  deb services reload NAME     Reload service as root
  deb services enable NAME     Enable service as root
  deb services disable NAME    Disable service as root
  deb services help            Show this help

Config:
  Edit DAT_SERVICES in /etc/debian-admin-toolkit/config to customize the list.
  Set DAT_SHOW_MISSING_SERVICES=1 to show missing services in the default list.
EOF
}

services_list() {
    local source_cmd="${1:-services_for_dashboard}"

    table_header "Service" "State" "Enabled"
    $source_cmd | while read -r service; do
        [[ -n "$service" ]] || continue
        service_row "$service"
    done
}

service_operation() {
    local name="$1"
    local operation="$2"

    require_root
    service_exists "$name" || die "Service not found: $name"

    case "$operation" in
        start) systemctl start "$name" ;;
        stop) systemctl stop "$name" ;;
        restart) systemctl restart "$name" ;;
        reload) systemctl reload "$name" ;;
        enable) systemctl enable "$name" ;;
        disable) systemctl disable "$name" ;;
        *) die "Unsupported service operation: $operation" ;;
    esac
}

COMMAND="${1:-list}"
shift || true

case "$COMMAND" in
    list)
        header "DebAdmin Services $DAT_VERSION"
        services_list services_for_dashboard
        footer_hint "deb services all | deb services status nginx"
        ;;
    all)
        header "DebAdmin Services $DAT_VERSION"
        services_list default_services
        footer_hint "deb services list hides missing services by default"
        ;;
    status|detail)
        service="${1:-}"
        [[ -n "$service" ]] || die "Service name required."
        header "DebAdmin Service: $service"
        service_detail "$service"
        ;;
    logs)
        service="${1:-}"
        lines="${2:-40}"
        [[ -n "$service" ]] || die "Service name required."
        header "DebAdmin Service Logs: $service"
        service_logs "$service" "$lines"
        ;;
    start|stop|restart|reload|enable|disable)
        service="${1:-}"
        [[ -n "$service" ]] || die "Service name required."
        service_operation "$service" "$COMMAND"
        header "DebAdmin Service: $service"
        service_detail "$service"
        ;;
    help|-h|--help)
        services_help
        ;;
    *)
        die "Unknown services command: $COMMAND"
        ;;
esac
