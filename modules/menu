#!/usr/bin/env bash
set -euo pipefail

DAT_CONFIG="${DAT_CONFIG:-/etc/debian-admin-toolkit/config}"
[[ -f "$DAT_CONFIG" ]] && source "$DAT_CONFIG"

DAT_HOME="${DAT_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
LIB_DIR="$DAT_HOME/lib"
MODULE_DIR="$DAT_HOME/modules"

source "$LIB_DIR/core.sh"
load_library colors
load_library output

header "DebAdmin $DAT_VERSION"

table_header "Command" "Status" "Description"
printf '%-28s %-14s %s\n' "health" "ready" "System dashboard"
printf '%-28s %-14s %s\n' "services" "ready" "Service panel and actions"
printf '%-28s %-14s %s\n' "ports" "ready" "Ports overview and lookup"
printf '%-28s %-14s %s\n' "doctor" "ready" "Diagnostics and health checks"
printf '%-28s %-14s %s\n' "backup" "ready" "Backup profiles and archives"
printf '%-28s %-14s %s\n' "logs" "ready" "Recent system logs"
printf '%-28s %-14s %s\n' "update" "ready" "Package update helper"

printf '\nRun: %sdeb health%s or %sdeb backup list%s\n' "$CYAN" "$RESET" "$CYAN" "$RESET"
