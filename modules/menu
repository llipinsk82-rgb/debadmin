#!/usr/bin/env bash
set -euo pipefail

DAT_CONFIG="${DAT_CONFIG:-/etc/debian-admin-toolkit/config}"
[[ -f "$DAT_CONFIG" ]] && source "$DAT_CONFIG"

DAT_HOME="${DAT_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
LIB_DIR="$DAT_HOME/lib"
MODULE_DIR="$DAT_HOME/modules"

source "$LIB_DIR/core.sh"
load_library colors
load_library output
load_library panel

COMMAND="${1:-show}"
shift || true

case "$COMMAND" in
    show|list)
        header "DebAdmin Panel $DAT_VERSION"
        panel_quick_status
        section "Commands"
        panel_table
        panel_examples
        footer_hint "deb menu run | deb health | deb update dry-run"
        ;;
    run|interactive)
        panel_run
        ;;
    help|-h|--help)
        panel_help
        ;;
    *)
        die "Unknown menu command: $COMMAND"
        ;;
esac
