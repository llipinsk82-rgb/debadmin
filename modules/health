#!/usr/bin/env bash
set -euo pipefail

DAT_CONFIG="${DAT_CONFIG:-/etc/debian-admin-toolkit/config}"
[[ -f "$DAT_CONFIG" ]] && source "$DAT_CONFIG"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAT_HOME="${DAT_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}"
LIB_DIR="$DAT_HOME/lib"
MODULE_DIR="$DAT_HOME/modules"

source "$LIB_DIR/core.sh"
load_library colors
load_library output
load_library system
load_library services

header "DebAdmin Health Dashboard $DAT_VERSION"

section "System"
kv "Hostname" "$(get_hostname)"
kv "OS" "$(get_os)"
kv "Kernel" "$(get_kernel)"
kv "Uptime" "$(get_uptime)"
kv "Load avg" "$(get_load)"

section "CPU"
kv "Model" "$(get_cpu_model || printf 'unknown')"
kv "Cores" "$(get_cpu_cores || printf 'unknown')"
kv "Temp" "$(get_cpu_temp)"
metric_bar "CPU" "$(get_cpu_usage)"

section "Memory / Disk"
metric_bar "RAM" "$(get_ram_percent)"
kv "RAM usage" "$(get_ram_summary)"
metric_bar "Disk" "$(get_disk_percent)"
kv "Disk usage" "$(get_disk_summary)"

section "Network"
kv "Local IP" "$(get_local_ip || printf 'n/a')"
kv "Public IP" "$(get_public_ip || printf 'n/a')"

section "Services"
table_header "Service" "State" "Enabled"
default_services | while read -r service; do
    [[ -n "$service" ]] || continue
    state="$(service_state "$service")"
    enabled="$(service_enabled_state "$service")"
    visual="$(service_visual_state "$state")"

    printf '%-20s %-23b %s\n' "$service" "$visual" "$enabled"
done

printf '\n'
