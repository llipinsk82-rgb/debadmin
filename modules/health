#!/usr/bin/env bash
set -euo pipefail

DAT_CONFIG="${DAT_CONFIG:-/etc/debian-admin-toolkit/config}"
[[ -f "$DAT_CONFIG" ]] && source "$DAT_CONFIG"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAT_HOME="${DAT_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}"
LIB_DIR="$DAT_HOME/lib"
MODULE_DIR="$DAT_HOME/modules"

source "$LIB_DIR/core.sh"
load_library colors
load_library output
load_library system
load_library services

cpu_percent="$(get_cpu_usage)"
ram_percent="$(get_ram_percent)"
disk_percent="$(get_disk_percent)"
local_ip="$(get_local_ip || printf 'n/a')"
public_ip="$(get_public_ip || printf 'n/a')"
service_info="$(service_summary)"

header "DebAdmin Health Dashboard $DAT_VERSION"

section "Overview"
summary_bar "CPU" "$cpu_percent"
summary_bar "RAM" "$ram_percent"
summary_bar "Disk" "$disk_percent"
kv "Services" "$service_info"

section "System"
kv "Hostname" "$(get_hostname)"
kv "OS" "$(get_os)"
kv "Kernel" "$(get_kernel)"
kv "Uptime" "$(get_uptime)"
kv "Load avg" "$(get_load)"

section "Hardware"
kv "CPU model" "$(get_cpu_model || printf 'unknown')"
kv "CPU cores" "$(get_cpu_cores || printf 'unknown')"
kv "CPU temp" "$(get_cpu_temp)"
kv "RAM usage" "$(get_ram_summary)"
kv "Disk usage" "$(get_disk_summary)"

section "Network"
kv "Local IP" "$local_ip"
kv "Public IP" "$public_ip"

section "Services"
table_header "Service" "State" "Enabled"
services_for_dashboard | while read -r service; do
    [[ -n "$service" ]] || continue
    state="$(service_state "$service")"
    enabled="$(service_enabled_state "$service")"
    visual="$(service_visual_state "$state")"

    printf '%-20s %-18b %s\n' "$service" "$visual" "$enabled"
done

footer_hint "deb services | deb doctor | deb ports"
