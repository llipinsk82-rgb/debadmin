#!/usr/bin/env bash
set -euo pipefail

DAT_CONFIG="${DAT_CONFIG:-/etc/debian-admin-toolkit/config}"
[[ -f "$DAT_CONFIG" ]] && source "$DAT_CONFIG"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DAT_HOME="${DAT_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}"
LIB_DIR="$DAT_HOME/lib"

source "$LIB_DIR/core.sh"
load_library colors
load_library output
load_library system
load_library services
load_library ports
load_library doctor

doctor_help() {
    cat <<EOF
DebAdmin Doctor $DAT_VERSION

Usage:
  deb doctor              Run all diagnostics
  deb doctor full         Run all diagnostics
  deb doctor system       Run system checks
  deb doctor tools        Run tool dependency checks
  deb doctor resources    Run CPU/RAM/disk checks
  deb doctor network      Run network checks
  deb doctor ports        Run port backend checks
  deb doctor services     Run configured service checks
  deb doctor help         Show this help
EOF
}

COMMAND="${1:-full}"
shift || true

case "$COMMAND" in
    full|run|check)
        header "DebAdmin Doctor $DAT_VERSION"
        doctor_run_all
        ;;
    system)
        header "DebAdmin Doctor: System"
        doctor_reset
        doctor_system_checks
        section "Summary"
        kv "Result" "$(doctor_summary)"
        ;;
    tools|deps|dependencies)
        header "DebAdmin Doctor: Tools"
        doctor_reset
        doctor_dependency_checks
        section "Summary"
        kv "Result" "$(doctor_summary)"
        ;;
    resources)
        header "DebAdmin Doctor: Resources"
        doctor_reset
        doctor_resource_checks
        section "Summary"
        kv "Result" "$(doctor_summary)"
        ;;
    network)
        header "DebAdmin Doctor: Network"
        doctor_reset
        doctor_network_checks
        section "Summary"
        kv "Result" "$(doctor_summary)"
        ;;
    ports)
        header "DebAdmin Doctor: Ports"
        doctor_reset
        doctor_port_checks
        section "Summary"
        kv "Result" "$(doctor_summary)"
        ;;
    services)
        header "DebAdmin Doctor: Services"
        doctor_reset
        doctor_service_checks
        section "Summary"
        kv "Result" "$(doctor_summary)"
        ;;
    help|-h|--help)
        doctor_help
        ;;
    *)
        die "Unknown doctor command: $COMMAND"
        ;;
esac
